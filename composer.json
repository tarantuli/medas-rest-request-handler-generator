{
  "name": "morphp/medas-rest-request-handler-generator",
  "description": "Medas REST request handler generator.",
  "keywords": [
    "http",
    "entities"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "morphp/medas-console": "^3",
    "morphp/medas-core": "^4",
    "morphp/medas-entity-generator": "^1",
    "morphp/medas-php-class-analysis": "^3",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\RestRequestHandlerGenerator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\RestRequestHandlerGeneratorTest\\": "tests/"
    }
  }
